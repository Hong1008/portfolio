---
import "../../styles/global.css";
import { getPublicProjects } from "../../lib/content";

const projects = (await getPublicProjects()).sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate),
);
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>프로젝트</title>
  </head>

  <body>
    <main>
      <header class="page-header">
        <p class="eyebrow">Portfolio</p>
        <h1>프로젝트</h1>
        <p>문제와 판단, 구현 범위와 검증 결과를 기록한 프로젝트입니다.</p>
      </header>

      <ul class="project-list">
        {
          projects.map((project) => (
            <li>
              <a href={`/projects/${project.data.slug}/`}>
                <p class="eyebrow">
                  {project.data.organization.displayName}
                </p>
                <h2>{project.data.title}</h2>
                <p>{project.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
