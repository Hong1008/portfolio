---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/site";
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 포트폴리오 페이지를 찾을 수 없습니다." canonicalPath="404/">
  <main id="main-content" class="not-found-page">
    <p class="eyebrow">404</p>
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p>주소가 변경됐거나 공개되지 않은 콘텐츠일 수 있습니다.</p>
    <a class="button primary" href={withBase()}>포트폴리오 홈으로</a>
  </main>
</BaseLayout>
